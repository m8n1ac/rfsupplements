# RF Supplements Ops CRM — copy to .env and fill in. Never commit .env.

DATABASE_URL="mysql://rfs_crm:PASSWORD@127.0.0.1:3306/rfs_crm"

# Auth.js v5.  AUTH_SECRET:        openssl rand -base64 32
AUTH_SECRET="base64-32-bytes"
AUTH_URL="https://ops.rfsupplements.com"
AUTH_TRUST_HOST="true"

# Reporting timezone (Gate 0, A2). WordPress stays on UTC; Gate 4 verifies in UTC.
STORE_TZ="America/Los_Angeles"

# Outbound mail — existing Gmail SMTP (Gate 0, B2). Use a dedicated App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ops@example.com"
SMTP_PASS="gmail-app-password"
MAIL_FROM="RF Supplements Ops <ops@example.com>"
ALERT_EMAIL="owner@example.com"

# WooCommerce REST, via the crm-sync Application Password (spec §7).
WOO_BASE_URL="https://rfsupplements.com/wp-json"
WOO_USER="crm-sync"
WOO_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
