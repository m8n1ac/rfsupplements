{
  "name": "rfs-ops-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "user:create": "NODE_OPTIONS=--conditions=react-server tsx scripts/user-create.ts",
    "test": "vitest run",
    "user:invite": "NODE_OPTIONS=--conditions=react-server tsx scripts/user-invite.ts",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "sync": "NODE_OPTIONS=--conditions=react-server tsx scripts/sync.ts",
    "fixtures:capture": "NODE_OPTIONS=--conditions=react-server tsx scripts/capture-fixtures.ts",
    "verify:orders": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-orders.ts",
    "verify:metrics": "NODE_OPTIONS=--conditions=react-server tsx scripts/verify-metrics.ts",
    "fixtures:store": "NODE_OPTIONS=--conditions=react-server tsx scripts/store-fixtures.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "mysql2": "^3.23.1",
    "deepmerge-ts": "^8.0.0",
    "mariadb": "~3.4.7"
  }
}
